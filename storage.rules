rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    // Mesmo critério do firestore.rules: acesso removido não vale.
    function hasProfile() {
      return signedIn()
        && firestore.exists(userDoc())
        && firestore.get(userDoc()).data.get('access_disabled', false) != true;
    }

    function profileRole() {
      return firestore.get(userDoc()).data.role;
    }

    function isInternal() {
      return hasProfile()
        && profileRole() in [
          'owner',
          'admin',
          'interno',
          'wms',
          'financeiro',
          'suporte'
        ];
    }

    function canWritePhotos() {
      return hasProfile()
        && profileRole() in ['owner', 'admin', 'interno', 'wms'];
    }

    // Unico prefixo tocado pelo SDK do browser
    // (features/warehouse-ops/shared.ts -> uploadBytes).
    // operational-documents e agent-knowledge nao passam por estas regras:
    // upload via signed URL v4, download via token do Storage e leitura
    // server-side pelo Admin SDK. Conceder acesso a eles aqui so ampliaria
    // superficie sem habilitar nenhum fluxo real.
    match /product-photos/{allPaths=**} {
      allow read: if isInternal();
      allow create: if canWritePhotos()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // write inclui delete: nenhum fluxo do produto apaga ou sobrescreve foto.
      allow update, delete: if false;
    }

    // Fotos da OS (docs/plataforma/fase-3-operacao.md, parte 3.7c): quem
    // coordena a Operação (owner, admin, interno) e quem está escalado na OS
    // (equipe_uids, o mesmo critério do firestore.rules) sobem a foto da OS
    // agendada ou em execução; suporte só lê. A foto só vale na OS depois
    // de attachPhoto, que confere o arquivo. Nada se sobrescreve nem apaga.
    function ordemDeServico(numero) {
      return firestore.get(/databases/(default)/documents/service_orders/$(numero));
    }

    function coordenaOperacao() {
      return hasProfile() && profileRole() in ['owner', 'admin', 'interno'];
    }

    function escaladoNaOs(numero) {
      return hasProfile()
        && profileRole() == 'campo'
        && request.auth.uid in ordemDeServico(numero).data.get('equipe_uids', []);
    }

    // A vistoria (parte 3.11a) vai ao Comercial com as fotos: quem orça
    // (comercial) lê as fotos da OS de vistoria, e só dela. Owner e admin já
    // leem por coordenarem a Operação.
    function fotoDeVistoria(numero) {
      return hasProfile()
        && profileRole() == 'comercial'
        && ordemDeServico(numero).data.get('tipo', 'servico') == 'vistoria';
    }

    // O comprovante da OS no portal (Fase 4, parte 4.3c): o cliente da OS
    // concluída (em revisão ou revisada, como o portal a mostra) lê a
    // assinatura e as fotos do final que a conclusão listou
    // (conclusao.arquivos_do_final). As fotos das ocorrências e das outras
    // etapas ficam internas, e a vistoria fica com a equipe e o Comercial.
    // A fronteira é o customer_code da OS. O módulo da Operação no contrato
    // não entra aqui porque o Storage lê no máximo dois documentos do
    // Firestore por avaliação (o perfil e a OS): ele já vale na leitura da
    // OS pelo firestore.rules, de onde o portal tira o nome dos arquivos.
    function clienteDaOsConcluida(numero) {
      return hasProfile()
        && profileRole() == 'cliente'
        && ordemDeServico(numero).data.get('customer_code', '') == firestore.get(userDoc()).data.get('customer_code', '-')
        && ordemDeServico(numero).data.get('status', '') in ['em_revisao', 'revisada']
        && ordemDeServico(numero).data.get('tipo', 'servico') != 'vistoria';
    }

    function conclusaoDaOs(numero) {
      return ordemDeServico(numero).data.get('conclusao', {});
    }

    match /os/{numero}/fotos/{arquivo} {
      allow read: if coordenaOperacao()
        || (hasProfile() && profileRole() == 'suporte')
        || escaladoNaOs(numero)
        || fotoDeVistoria(numero)
        || (clienteDaOsConcluida(numero) && arquivo in conclusaoDaOs(numero).get('arquivos_do_final', []));
      allow create: if resource == null
        && (coordenaOperacao() || escaladoNaOs(numero))
        && numero.matches('^[0-9]{5,8}-[0-9]{2}$')
        && arquivo.matches('^ft_[a-f0-9]{16}[.](jpg|png|webp)$')
        && ordemDeServico(numero).data.status in ['agendada', 'em_execucao']
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Assinatura do responsável do cliente (parte 3.9a): a mesma regra das
    // fotos, só na OS em execução (é o aceite da conclusão). Vale na OS
    // depois de completeServiceOrder, que confere o arquivo.
    match /os/{numero}/assinatura/{arquivo} {
      allow read: if coordenaOperacao()
        || (hasProfile() && profileRole() == 'suporte')
        || escaladoNaOs(numero)
        || (clienteDaOsConcluida(numero) && conclusaoDaOs(numero).get('assinatura', '') == 'os/' + numero + '/assinatura/' + arquivo);
      allow create: if resource == null
        && (coordenaOperacao() || escaladoNaOs(numero))
        && numero.matches('^[0-9]{5,8}-[0-9]{2}$')
        && arquivo.matches('^as_[a-f0-9]{16}[.](jpg|png|webp)$')
        && ordemDeServico(numero).data.status == 'em_execucao'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Anexo da solicitação de OS pelo portal (Fase 4, parte 4.4a): o cliente
    // com a Operação no contrato (client_access, o mesmo critério do
    // firestore.rules; sem o documento valem armazenagem e faturas) sobe a
    // nota fiscal ou o documento no caminho do próprio código. Quem coordena
    // e o suporte leem; o cliente lê os próprios. O anexo só vale na
    // solicitação depois de requestService, que confere o arquivo. Nada se
    // sobrescreve nem apaga.
    function modulosDoCliente(code) {
      return firestore.exists(/databases/(default)/documents/client_access/$(code))
        ? firestore.get(/databases/(default)/documents/client_access/$(code)).data.get('modules', ['wms', 'financeiro'])
        : ['wms', 'financeiro'];
    }

    function clienteComOperacao(code) {
      return hasProfile()
        && profileRole() == 'cliente'
        && firestore.get(userDoc()).data.get('customer_code', '') == code
        && 'operacao' in modulosDoCliente(code);
    }

    match /portal/{code}/solicitacoes/{arquivo} {
      allow read: if coordenaOperacao()
        || (hasProfile() && profileRole() == 'suporte')
        || clienteComOperacao(code);
      allow create: if resource == null
        && clienteComOperacao(code)
        && arquivo.matches('^an_[a-f0-9]{16}[.](pdf|jpg|png|webp)$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Os arquivos do RH (rh/**, Fase 8, parte 8.2b) caem aqui de propósito:
    // fechados a todo papel, sobem e abrem só por URL assinada das callables
    // do RH, que conferem o papel e registram cada abertura
    // (functions/wms/src/rh-arquivos.rules.test.ts).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
