rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && firestore.exists(userDoc());
    }

    function profileRole() {
      return firestore.get(userDoc()).data.role;
    }

    function isInternal() {
      return hasProfile()
        && profileRole() in [
          'owner',
          'admin',
          'interno',
          'wms',
          'financeiro',
          'suporte'
        ];
    }

    match /agent-knowledge/{allPaths=**} {
      allow read, write: if isInternal();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
