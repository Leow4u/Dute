VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_API_MODE foi removido: rotas com backend em Cloud Functions sempre usam Functions.

# Agent Dute transactional notifications
# audit_only registra envio aprovado sem disparar e-mail externo.
# webhook envia para um provedor transacional via POST JSON.
AGENT_DUTE_EMAIL_MODE=audit_only
AGENT_DUTE_EMAIL_FROM=Agent Dute <nao-responder@dutelog.com.br>
AGENT_DUTE_EMAIL_REPLY_TO=
AGENT_DUTE_EMAIL_CLIENT_TO=
AGENT_DUTE_EMAIL_INTERNAL_TO=
AGENT_DUTE_EMAIL_WEBHOOK_URL=
AGENT_DUTE_EMAIL_WEBHOOK_TOKEN=

# Functions WMS: modelo Vertex AI para editar fotos de produtos (no global, o único local do
# gemini-3-pro-image; functions/wms/src/domain/vertex-location.ts).
PRODUCT_PHOTO_MODEL=gemini-3-pro-image
# Conferência visual de apresentação e fidelidade antes de salvar qualquer proposta.
# Vazio usa os modelos do Agent Dute (gemini-3.5-flash e, se falhar, gemini-3.8-flash).
# Roda na multirregião us: o modelo informado precisa existir lá.
PRODUCT_PHOTO_REVIEW_MODEL=
