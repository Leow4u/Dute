  {
    "method": "POST",
    "path": "/api/v1/rh/registros",
    "scope": "rh:registros:gravar",
    "summary": "Criar registros",
    "responseFields": [
      "id",
      "edicao",
      "situacao",
      "replayed"
    ],
    "customerRequired": false,
    "requestSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colaborador_id": {
          "type": "string",
          "pattern": "^col_[a-f0-9]{16}$"
        },
        "categoria": {
          "type": "string",
          "enum": [
            "documento",
            "exame",
            "treinamento"
          ]
        },
        "tipo": {
          "type": "string",
          "description": "Tipo do catálogo da categoria; outro exige descricao."
        },
        "descricao": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "emitido_em": {
          "type": "string",
          "format": "date"
        },
        "vence_em": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultado": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "apto",
            "apto_com_restricao",
            "inapto",
            null
          ]
        }
      },
      "required": [
        "colaborador_id",
        "categoria",
        "tipo",
        "emitido_em"
      ]
    }
  },
