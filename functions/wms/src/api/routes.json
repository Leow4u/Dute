  {
    "method": "PATCH",
    "path": "/api/v1/armazenagem/recebimentos/{id}",
    "scope": "armazenagem:recebimentos:gravar",
    "summary": "Conferir linhas do recebimento",
    "requestSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inbound_item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "received_qty": {
                "type": "number",
                "minimum": 0
              },
              "location_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "client_item_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "inbound_item_id",
              "received_qty"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]{1,9}$",
          "description": "Versão updateTime seconds:nanoseconds retornada por GET /recebimentos/{id}; edição concorrente retorna 409."
        }
      },
      "required": [
        "expected_status",
        "lines",
        "expected_version"
      ]
    }
  },
