  {
    "method": "POST",
    "path": "/api/v1/armazenagem/pedidos",
    "scope": "armazenagem:pedidos:gravar",
    "summary": "Criar pedido (sem anexos nem valores); produto existente exige SKU",
    "requestSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customer_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_item_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "product_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "barcode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "size": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "color": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sku_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "location_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "product_registration": {
                "type": "string",
                "enum": [
                  "existing",
                  "new"
                ]
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "quantity"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "priority": {
          "type": "string",
          "enum": [
            "normal",
            "high",
            "urgent"
          ],
          "default": "normal"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "due_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supplier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "invoice_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "type": {
          "type": "string",
          "enum": [
            "recebimento",
            "retirada",
            "solicitacao"
          ]
        }
      },
      "required": [
        "customer_code",
        "type",
        "items"
      ]
    }
  },
  {
    "method": "PATCH",
    "path": "/api/v1/armazenagem/pedidos/{id}",
    "scope": "armazenagem:pedidos:gravar",
    "summary": "Aprovar ou encerrar pedido; sem cancelamento ou rejeição",
    "requestSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "approve",
            "close"
          ]
        },
        "expected_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "action",
        "expected_status"
      ]
    }
  },
