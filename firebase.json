{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["pnpm --dir \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8088
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
