# Modo local com emuladores (docs/plataforma/ambiente-local.md).
#
# O Vite deste app lê o .env da RAIZ do repositório (envDir em vite.config.ts).
# Copie este arquivo para C:\DEV\Dute\.env.local (o .gitignore já ignora) e
# apague a cópia quando terminar: o .env.local vale também para `vite build`.
#
# Tudo abaixo é fictício. Nenhuma chave é real e nada aqui fala com a nuvem.
VITE_FIREBASE_EMULATORS=1
VITE_FIREBASE_PROJECT_ID=dute-homolog
VITE_FIREBASE_API_KEY=chave-ficticia-emulador-local
VITE_FIREBASE_AUTH_DOMAIN=dute-homolog.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=dute-homolog.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
