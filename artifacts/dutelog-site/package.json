{
  "name": "@workspace/dutelog-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/build-runtime.mjs",
    "start": "node dist/runtime/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:build": "node --test tests/build.test.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "express": "5.3.0",
    "firebase": "12.15.0",
    "firebase-admin": "14.5.0",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "5",
    "@types/node": "22",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "0.27.3",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  }
}
