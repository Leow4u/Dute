FROM node:22-alpine AS build

# O CI (pnpm/action-setup version: 9) instala o pnpm 9.15.9. Sem este pin,
# `corepack enable` baixa o pnpm 12 e `pnpm install --frozen-lockfile` falha
# com ERR_PNPM_LOCKFILE_CONFIG_MISMATCH (overrides do workspace vs lockfile).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /workspace

# .npmrc define auto-install-peers=false. O pnpm 9 não lê isso do
# pnpm-workspace.yaml; sem o arquivo o frozen-lockfile falha de novo
# (settings.autoInstallPeers).
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY artifacts/dutelog-site/package.json artifacts/dutelog-site/package.json

RUN pnpm install --frozen-lockfile

COPY artifacts/dutelog-site artifacts/dutelog-site
RUN pnpm --filter @workspace/dutelog-site build

FROM nginx:1.27-alpine

COPY deploy/cloud-run/nginx-site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/artifacts/dutelog-site/dist/public /usr/share/nginx/html

EXPOSE 8080
